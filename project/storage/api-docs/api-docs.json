    "components": {
        "schemas": {
            "Notification": {
                "title": "Notification",
                "description": "Уведомление подписчику",
                "required": [
                    "id",
                    "request_key",
                    "message",
                    "channel",
                    "priority",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "request_key": {
                        "type": "string",
                        "example": "key_example"
                    },
                    "message": {
                        "type": "string",
                        "example": "Example message"
                    },
                    "channel": {
                        "type": "string",
                        "example": "email",
                        "enum": [
                            "email",
                            "sms"
                        ]
                    },
                    "priority": {
                        "type": "string",
                        "example": "low",
                        "enum": [
                            "high",
                            "low"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "example": "queued",
                        "default": "queued",
                        "enum": [
                            "queued",
                            "sent",
                            "delivered",
                            "rejected"
                        ]
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    }
                },
                "type": "object"
            },
            "Subscriber": {
                "title": "Subscriber",
                "description": "Подписчик",
                "required": [
                    "id",
                    "email",
                    "phone"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "example@example.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "+7 999 000 00 00"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    }
                },
                "type": "object"
            }
        }
    },
