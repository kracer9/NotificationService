{
    "openapi": "3.0.0",
    "info": {
        "title": "Notification Service",
        "description": "Сервис рассылки уведомлений",
        "version": "1.0.0"
    },
    "paths": {
        "/api/notifications": {
            "get": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Получить список уведомлений",
                "operationId": "d1b1bb2774f3243f1c2b8c3387019035",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Номер страницы",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список уведомлений",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Notification"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Передать сервису уведомление для рассылки",
                "operationId": "fe5e68b20e3befb480ec8fbd5d2aee0d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "request_key",
                                    "message",
                                    "channel",
                                    "priority",
                                    "subscribers"
                                ],
                                "properties": {
                                    "request_key": {
                                        "type": "string",
                                        "example": "example_key"
                                    },
                                    "message": {
                                        "type": "string",
                                        "example": "Example message"
                                    },
                                    "channel": {
                                        "type": "string",
                                        "example": "email",
                                        "enum": [
                                            "email",
                                            "sms"
                                        ]
                                    },
                                    "priority": {
                                        "type": "string",
                                        "example": "low",
                                        "enum": [
                                            "high",
                                            "low"
                                        ]
                                    },
                                    "subscriber_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "example": [
                                            1,
                                            2,
                                            3
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Уведомление принято в работу",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "Accepted"
                                        },
                                        "results": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "subscriber_id": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "notification_id": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Уведомление уже в работе",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "Already processing"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/notifications/by_subscriber/{subscriberId}": {
            "get": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Получить список уведомлений подписчика",
                "operationId": "24bd73473738b8efd98a8a1896c6b33e",
                "parameters": [
                    {
                        "name": "subscriberId",
                        "in": "path",
                        "description": "Идентификатор подписчика",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Номер страницы",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список уведомлений",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Notification"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/subscribers": {
            "get": {
                "tags": [
                    "Subscribers"
                ],
                "summary": "Получить список подписчиков",
                "operationId": "b5fd9078577adbe9f216e478b37d375f",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Номер страницы",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список подписчиков (постраничный)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Subscriber"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Subscribers"
                ],
                "summary": "Добавить подписчика",
                "operationId": "cdbdfb57ab947416e0ecf36c82ed29e8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "phone"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "example@example.com"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "+7 999 000 00 00"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Подписчик сохранён",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "examples": {
                                    "id": {
                                        "summary": "Object with subscriber id",
                                        "value": {
                                            "data": {
                                                "id": 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Notification": {
                "title": "Notification",
                "description": "Уведомление подписчику",
                "required": [
                    "id",
                    "request_key",
                    "message",
                    "channel",
                    "priority",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "request_key": {
                        "type": "string",
                        "example": "key_example"
                    },
                    "message": {
                        "type": "string",
                        "example": "Example message"
                    },
                    "channel": {
                        "type": "string",
                        "example": "email",
                        "enum": [
                            "email",
                            "sms"
                        ]
                    },
                    "priority": {
                        "type": "string",
                        "example": "low",
                        "enum": [
                            "high",
                            "low"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "example": "queued",
                        "default": "queued",
                        "enum": [
                            "queued",
                            "sent",
                            "delivered",
                            "rejected"
                        ]
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    }
                },
                "type": "object"
            },
            "Subscriber": {
                "title": "Subscriber",
                "description": "Подписчик",
                "required": [
                    "id",
                    "email",
                    "phone"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "example@example.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "+7 999 000 00 00"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00Z"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Notifications",
            "description": "Notifications"
        },
        {
            "name": "Subscribers",
            "description": "Subscribers"
        }
    ]
}