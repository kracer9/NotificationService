                ],
                "operationId": "7a6bb14e6793922b9388f0d82c459e5d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "phone"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "example@example.com"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "+7 999 000 00 00"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Подписчик сохранён",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "examples": {
                                    "id": {
                                        "summary": "Object with subscriber id",
                                        "value": {
                                            "id": 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
