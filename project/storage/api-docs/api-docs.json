    "paths": {
        "/notifications": {
            "get": {
                "tags": [
                    "Notifications"
                ],
                "operationId": "a1ae991b863d586cfe9172c9f96399ce",
                "responses": {
                    "200": {
                        "description": "Список уведомлений (первая страница)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Notification"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Notifications"
                ],
                "operationId": "5ce63496435eb78b5c4c52c7d398dfcf",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "request_key",
                                    "message",
                                    "channel",
                                    "priority",
                                    "subscribers"
                                ],
                                "properties": {
                                    "request_key": {
                                        "type": "string",
                                        "example": "example_key"
                                    },
                                    "message": {
                                        "type": "string",
                                        "example": "Example message"
                                    },
                                    "channel": {
                                        "type": "string",
                                        "example": "email",
                                        "enum": [
                                            "email",
                                            "sms"
                                        ]
                                    },
                                    "priority": {
                                        "type": "string",
                                        "example": "low",
                                        "enum": [
                                            "high",
                                            "low"
                                        ]
                                    },
                                    "subscribers": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "example": [
                                            1
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Уведомление принято в работу"
                    },
                    "200": {
                        "description": "Уведомление уже в работе"
                    }
                }
            }
        },
